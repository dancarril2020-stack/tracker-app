rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get the requesting user's tenantId from their profile
    function userTenantId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    // --- RECORDS ---
    // Users can only read/write records in their own tenant, OR records where they are the supplier
    match /records/{recordId} {
      allow read: if request.auth != null && (
        // Resource exists: check tenantId matches OR they are the supplier
        (resource != null && (resource.data.tenantId == userTenantId() || resource.data.supplierId == request.auth.uid)) ||
        // Creating new: check incoming data's tenantId matches OR they are the supplier
        (resource == null && (request.resource.data.tenantId == userTenantId() || request.resource.data.supplierId == request.auth.uid))
      );
      allow create: if request.auth != null && (
        request.resource.data.tenantId == userTenantId() ||
        request.resource.data.supplierId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.tenantId == userTenantId() ||
        resource.data.supplierId == request.auth.uid
      );
    }

    // --- DEBTS ---
    match /debts/{debtId} {
      allow read: if request.auth != null && (
        resource != null && resource.data.tenantId == userTenantId()
      );
      allow create: if request.auth != null &&
        request.resource.data.tenantId == userTenantId();
      allow update, delete: if request.auth != null &&
        resource.data.tenantId == userTenantId();
    }

    // --- USERS ---
    // Users can only read their own profile and profiles in their tenant
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for driver lists)
      allow read: if request.auth != null;
      // Only authenticated users can create (via registerUser function)
      allow create: if request.auth != null;
      // Users can update their own profile; backoffice can update any
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'backoffice'
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'backoffice';
    }

    // --- AUDIT LOGS ---
    // All authenticated users can create; only backoffice can read all
    match /audit_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'backoffice';
    }
  }
}
